# Copy this file to `.env` and fill in values for local development.
# The AzureML job does NOT read .env - it computes paths from AZUREML_* env
# vars automatically.

# ---- Directories (all optional; sensible defaults resolve relative to the
# repo root when these are unset) ----------------------------------------
# Read-only source data directory (defaults to ./data).
DATA_DIR=./data

# Preprocessed + topic-annotated CSVs go here. Kept separate from DATA_DIR
# so raw inputs are never overwritten (defaults to ./outputs/processed).
PROCESSED_DATA_DIR=./outputs/processed

# Emotion-classified CSVs (defaults to ./outputs/data).
OUTPUT_DATA_DIR=./outputs/data

# Interactive HTML + PNG visualizations (defaults to ./outputs/visualizations).
OUTPUT_VIS_DIR=./outputs/visualizations

# Serialized topic models (defaults to ./outputs/models).
MODELS_DIR=./outputs/models

# ---- Raw data ingestion (only needed for reddit/twitter filtering scripts) ----
REDDIT_RAW_DIR=
TWITTER_RAW_DIR=

# ---- Optional integrations ------------------------------------------------
# Cohere is used for topic label generation; pipeline runs without it.
COHERE_API_KEY=

# ---- Logging --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
